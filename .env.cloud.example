# CyberShield SatCom 3D - cloud settings (copy to .env on the server; never commit it)
# Passwords: long and random. Change the dashboard passwords after the first login too.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Huawei Cloud RDS for PostgreSQL instead of the db container (optional):
# DATABASE_URL=postgresql://user:password@<rds-private-ip>:5432/cybershield
# v2.4: managed cloud MQTT broker instead of the mqtt container (docs/CLOUD_MQTT.md)
# MQTT_HOST=xxxxxxxx.s1.eu.hivemq.cloud
# MQTT_PORT=8883
# MQTT_TLS=true
# MQTT_USERNAME=
# MQTT_PASSWORD=
AUTH_ENABLED=true
SIM_AUTOSTART=true
FRONTEND_ORIGINS=http://<server-ip>
# Optional, see the other docs:
# AI_PROVIDER=deepseek          (DeepSeek, docs/DEEPSEEK_AI.md)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# NOTIFY_ENABLED=true
# NTFY_TOPIC=
# Prometheus / Huawei Cloud AOM scraping of /metrics (long random token; empty = off)
# METRICS_TOKEN=
