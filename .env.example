# Copy this file to .env and change values if needed. All have defaults.
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HEARTBEAT_INTERVAL=2
# Phase 2
SIM_INTERVAL=5
SIM_AUTOSTART=true
OFFLINE_AFTER=15
# Phase 3 (MQTT broker)
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=cybershield
# Phase 4
NET_RANDOM_EVENTS=true
# Phase 5 (detection thresholds)
RATE_WINDOW_SECONDS=5
RATE_THRESHOLD_PER_SEC=10
CONN_WINDOW_SECONDS=30
CONN_THRESHOLD=5
ABNORMAL_MARGIN=15
ALERT_COOLDOWN_SECONDS=30
# Phase 6 (quarantine)
AUTO_QUARANTINE=true
AUTO_QUARANTINE_ALERTS=excessive_message_rate,suspicious_connections,device_id_spoofing

# ---- Phase 8: failover
FAILOVER_ENABLED=true
HANDOVER_DELAY_MIN=1.5
HANDOVER_DELAY_MAX=3.0
FAILBACK_STABLE_SECONDS=10
FAILOVER_ON_DEGRADED=true
DEGRADED_FAILOVER_SECONDS=6
DRILL_SECONDS=30

# ---- Phase 9: 4D timeline
TIMELINE_MAX_SNAPSHOTS=5400

# ---- Phase 11: real ESP32 + DHT22 (set to true when you connect the board)
ESP32_ENABLED=false
ESP32_DEVICE_ID=ESP32-001

# ---- Phase 12: optional ML detector (pip install -r backend/requirements-ml.txt)
ML_ENABLED=false
ML_MIN_TRAINING_READINGS=120
ML_CONTAMINATION=0.01
ML_MARGIN=1.0

# ---- v1.1: login and roles (viewer < operator < admin)
AUTH_ENABLED=true
AUTH_TOKEN_HOURS=12
# Accounts created on the FIRST start only. Change the passwords after logging in.
ADMIN_USER=admin
ADMIN_PASSWORD=Admin@2026
OPERATOR_USER=operator
OPERATOR_PASSWORD=Operator@2026
VIEWER_USER=viewer
VIEWER_PASSWORD=Viewer@2026
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=60

# ---- v1.1: secure MQTT (see docs/SECURE_MQTT.md)
# MQTT_USERNAME=backend
# MQTT_PASSWORD=change-me
MQTT_TLS=false
# MQTT_PORT=8883
# MQTT_CA_CERT=D:\CyberShield-SatCom-3D\iot\mosquitto\certs\ca.crt
# ---- v2.4: cloud MQTT broker instead of the local Mosquitto (docs/CLOUD_MQTT.md)
# MQTT_HOST=xxxxxxxx.s1.eu.hivemq.cloud
# MQTT_PORT=8883
# MQTT_TLS=true
# MQTT_USERNAME=cybershield
# MQTT_PASSWORD=your-broker-password
# MQTT_CA_CERT=            (empty = system CAs, right for cloud brokers)
# MQTT_TOPIC_PREFIX=cybershield-yourname   (unique prefix on a shared broker)
# MQTT_CLIENT_ID=

# ---- v1.1: motion sensors (PIR)
MOTION_NIGHT_START=22
MOTION_NIGHT_END=6
MOTION_ALERT_ALWAYS=false

# ---- v1.1: AI assistant (works offline without a key)
# v2.6: AI analyst on DeepSeek, see docs/DEEPSEEK_AI.md
# AI_PROVIDER = deepseek (default) | huawei | gemini | groq | openrouter | omniroute
# omniroute = your own OmniRoute gateway (github.com/cheaper-inference/OmniRoute), no key needed by default
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Huawei Cloud MaaS (only with AI_PROVIDER=huawei and AI_API_KEY):
HUAWEI_MAAS_URL=https://api-ap-southeast-1.modelarts-maas.com/v1
HUAWEI_MAAS_MODEL=DeepSeek-V3
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=30
# Address of OmniRoute (or any OpenAI-compatible server such as Ollama: http://localhost:11434/v1)
OMNIROUTE_URL=http://localhost:20128/v1

# ---- v1.2: many companies on one system (see README section 23)
# Demo companies (farm_admin / Farm@2026, offices_admin / Offices@2026, solar_admin / Solar@2026)
SEED_DEMO_COMPANIES=true

# ---- v1.2: phone alarm (docs/PHONE_ALARM.md). Also settable in Admin -> Phone alarm.
NOTIFY_ENABLED=false
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NOTIFY_MIN_SEVERITY=medium
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# v1.3: summarise live readings into the hourly tables every N seconds
ROLLUP_INTERVAL_SECONDS=300
# PostgreSQL instead of SQLite (optional): DATABASE_URL=postgresql://user:password@host:5432/cybershield

# v1.4: three bigger demo customers (mine, hospital, cold chain) with 6 more devices, added once
SEED_BIG_COMPANIES=true
# v1.4 (cloud monitoring): Prometheus metrics at /metrics, only with this secret Bearer token (empty = off)
METRICS_TOKEN=

# ---- v2.1 SOC (README section 29, docs/FINAL_REPORT.md)
# Security event store: keep events this many days; one MQTT flow record per device every N seconds
SECURITY_EVENT_RETENTION_DAYS=7
FLOW_SUMMARY_SECONDS=60
# Detection thresholds for the new rules CS-011..CS-021
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_SECONDS=60
PORT_SCAN_THRESHOLD=15
PORT_SCAN_WINDOW_SECONDS=30
BEACON_MIN_CONNECTIONS=6
BEACON_MAX_JITTER=0.25
EXFIL_BYTES_PER_MINUTE=5242880
G5_AUTH_FAIL_THRESHOLD=4
GNSS_MIN_CN0=25
GNSS_MAX_SPEED_MPS=300
# Threat intelligence enrichment (optional; empty = off). Keys stay on the server, never sent to the browser.
# Documentation (203.0.113.x, 198.51.100.x) and private addresses are never sent to these services.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
INTEL_TIMEOUT=8
# Example IOCs (simulated C2 / drop addresses), added once
SEED_DEMO_IOCS=true
# Containment approvals: true = nobody may approve their own request
APPROVAL_TWO_PERSON=false
# SOC demo accounts analyst_l1 / analyst_l2 / analyst_l3 / soc_manager, added once
SEED_SOC_USERS=true
# Roles that must set up two-factor (TOTP) before using the app, e.g. admin,soc_manager (empty = optional)
MFA_REQUIRED_ROLES=

# ---- v2.2 Huawei Cloud (docs/HUAWEI_INNOVATION.md)
# IoTDA data forwarding: secret token in the push URL https://<server>/api/iotda/push?token=<this>. Empty = off.
IOTDA_PUSH_TOKEN=
IOTDA_REGION=
# Anomaly model trained on ModelArts / MindSpore (ml/modelarts/train.py). Default: backend/models/anomaly_ae.json
AE_MODEL_PATH=
AE_ENABLED=true
# ESP32 send interval in seconds (SEND_EVERY_MS / 1000), used by the lab test report
LAB_SEND_INTERVAL_SECONDS=5
